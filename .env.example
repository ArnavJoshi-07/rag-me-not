# copy to .env and fill in. the password only takes effect when the postgres volume is first created
POSTGRES_USER=ragmenot
# generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=ragmenot
# port published on 127.0.0.1 of the host
POSTGRES_PORT=5432

# embeddings services: embeddings-indexing embeds Chunks for ingestion, embeddings-query embeds Queries for chat.
# ports published on 127.0.0.1 of the host
EMBEDDINGS_INDEXING_PORT=8091
EMBEDDINGS_QUERY_PORT=8090
# CPUs per service, a whole number no larger than the host's. also sets the service's MKL / OpenMP / Rayon threads
EMBEDDINGS_INDEXING_CPUS=4
EMBEDDINGS_QUERY_CPUS=2
# memory limits, ~1.25x the peak measured at each service's worst case with the default CPUs (2.2 / 1.4 GiB)
EMBEDDINGS_INDEXING_MEMORY=2.8g
EMBEDDINGS_QUERY_MEMORY=1.8g
